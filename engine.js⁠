/**
 * Vidya Engine - Top-Down Bias, Session Sweeps & Big Player Reversals
 */

const VidyaEngineModule = {
    getHTFBias: function(tfData) {
        if (!tfData || !tfData['1d'] || !tfData['4h']) return "NEUTRAL";
        let d1 = tfData['1d'];
        let h4 = tfData['4h'];
        
        let d1Trend = d1[d1.length - 1].close > d1[d1.length - 5].close ? "BULLISH" : "BEARISH";
        let h4Trend = h4[h4.length - 1].close > h4[h4.length - 5].close ? "BULLISH" : "BEARISH";

        return d1Trend === h4Trend ? d1Trend : "CONSOLIDATION";
    },

    detectSessionSweep: function(tfData) {
        if (!tfData || !tfData['15m']) return { swept: false };
        let m15 = tfData['15m'];
        let last = m15[m15.length - 1];
        let prevRange = m15.slice(-20, -1);

        let swingHigh = Math.max(...prevRange.map(c => c.high));
        let swingLow = Math.min(...prevRange.map(c => c.low));

        let bullishSweep = last.low < swingLow && last.close > swingLow;
        let bearishSweep = last.high > swingHigh && last.close < swingHigh;

        return {
            swept: bullishSweep || bearishSweep,
            direction: bullishSweep ? 'BUY' : bearishSweep ? 'SELL' : 'NONE',
            swingHigh,
            swingLow
        };
    }
};
