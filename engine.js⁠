/**
 * Vidya Engine Module - SMC Signal Generator & Wallet Management
 */

const VidyaEngineModule = {
    WALLET_KEY: 'vidya_paper_wallet_v100',

    getWalletState: function() {
        let saved = localStorage.getItem(this.WALLET_KEY);
        if (saved) {
            try { return JSON.parse(saved); } catch(e) {}
        }
        return {
            balance: 10000.0,
            equity: 10000.0,
            openTrades: [],
            tradeHistory: [],
            totalPnL: 0.0
        };
    },

    saveWalletState: function(state) {
        try { localStorage.setItem(this.WALLET_KEY, JSON.stringify(state)); } catch(e) {}
    },

    // Evaluate Live Signal via SMC, Imbalance & Magnet Walls
    evaluateSMCSignal: function(tfData) {
        if (!tfData) return null;

        let labels = VidyaStrategies.extractSMCLabels(tfData);
        let m1 = tfData['1m'];
        let m15 = tfData['15m'];
        let h1 = tfData['1h'];

        if (!labels || !m1 || !m15 || !h1) return null;

        let imbalance = VidyaStrategies.calculateDeltaImbalance();
        let walls = VidyaStrategies.getHeatmapWalls();
        let currentPrice = m1[m1.length - 1].close;

        let { pdh, pdl, ash, asl } = labels;

        // HTF Direction Filter
        let h1Current = h1[h1.length - 1].close;
        let h1Prev = h1[Math.max(0, h1.length - 5)].close;
        let isH1Bullish = h1Current >= h1Prev;

        let last15m = m15[m15.length - 1];
        let isSweepLow = last15m.low < asl || last15m.low < pdl;
        let isSweepHigh = last15m.high > ash || last15m.high > pdh;

        let direction = "NEUTRAL";
        let targetMagnet = currentPrice;
        let protectedSL = currentPrice;
        let sweptLabel = "";
        let pendingMagnet = "";

        if (isSweepLow && imbalance.isBuyerAggressive && isH1Bullish) {
            direction = "BUY";
            sweptLabel = currentPrice < pdl ? "PDL" : "ASL";
            pendingMagnet = currentPrice < pdl ? "PDH" : "ASH";
            targetMagnet = (walls && walls.sellWall) ? walls.sellWall.price : (currentPrice < pdl ? pdh : ash);
            protectedSL = last15m.low * 0.9990;
        } else if (isSweepHigh && imbalance.isSellerAggressive && !isH1Bullish) {
            direction = "SELL";
            sweptLabel = currentPrice > pdh ? "PDH" : "ASH";
            pendingMagnet = currentPrice > pdh ? "PDL" : "ASL";
            targetMagnet = (walls && walls.buyWall) ? walls.buyWall.price : (currentPrice > pdh ? pdl : asl);
            protectedSL = last15m.high * 1.0010;
        }

        if (direction === "NEUTRAL") return null;

        let risk = Math.abs(currentPrice - protectedSL);
        let reward = Math.abs(targetMagnet - currentPrice);
        let rrRatio = risk > 0 ? (reward / risk).toFixed(1) : "3.0";

        return {
            direction,
            currentPrice,
            entry: currentPrice,
            targetMagnet,
            protectedSL,
            rrRatio: `1:${rrRatio}`,
            sweptLabel,
            pendingMagnet,
            deltaRatio: imbalance.deltaRatio
        };
    },

    // Process Live Wallet Orders
    processWalletTrade: function(symbol, signal) {
        let wallet = this.getWalletState();
        if (wallet.openTrades.some(t => t.symbol === symbol)) return wallet;

        let riskAmount = wallet.balance * 0.02; // 2% Risk
        let priceRisk = Math.abs(signal.entry - signal.protectedSL);
        let positionSize = priceRisk > 0 ? (riskAmount / priceRisk) : 1;

        let newTrade = {
            id: Date.now(),
            symbol,
            type: signal.direction,
            entry: signal.entry,
            targetTP: signal.targetMagnet,
            stopLoss: signal.protectedSL,
            size: positionSize,
            timestamp: new Date().toLocaleTimeString()
        };

        wallet.openTrades.push(newTrade);
        this.saveWalletState(wallet);
        return wallet;
    },

    // Monitor Open Positions against Live Price
    updateWalletPnL: function(symbol, livePrice) {
        let wallet = this.getWalletState();
        let updatedTrades = [];
        let closedPnL = 0;

        for (let trade of wallet.openTrades) {
            if (trade.symbol !== symbol) {
                updatedTrades.push(trade);
                continue;
            }

            let isWin = false;
            let isClosed = false;

            if (trade.type === 'BUY') {
                if (livePrice >= trade.targetTP) { isWin = true; isClosed = true; }
                else if (livePrice <= trade.stopLoss) { isWin = false; isClosed = true; }
            } else {
                if (livePrice <= trade.targetTP) { isWin = true; isClosed = true; }
                else if (livePrice >= trade.stopLoss) { isWin = false; isClosed = true; }
            }

            if (isClosed) {
                let pnl = isWin ? (Math.abs(trade.targetTP - trade.entry) * trade.size) : (-Math.abs(trade.entry - trade.stopLoss) * trade.size);
                wallet.balance += pnl;
                wallet.totalPnL += pnl;
                wallet.tradeHistory.push({ ...trade, closePrice: livePrice, pnl, result: isWin ? 'WIN' : 'LOSS' });
            } else {
                updatedTrades.push(trade);
            }
        }

        wallet.openTrades = updatedTrades;
        wallet.equity = wallet.balance;
        this.saveWalletState(wallet);
        return wallet;
    }
};
