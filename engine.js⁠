/**
 * Vidya Engine Module - Institutional Session & Orderflow Validation
 */

const VidyaEngineModule = {
    validateInstitutionalConfluence: function(rallyData) {
        if (!rallyData.triggered) return { valid: false };

        let currentHour = new Date().getUTCHours();
        let sessionName = "ASIAN RANGE";
        let sessionMultiplier = 1.0;

        // London Killzone & New York Killzone high-probability filters
        if (currentHour >= 7 && currentHour <= 10) {
            sessionName = "LONDON KILLZONE";
            sessionMultiplier = 1.2;
        } else if (currentHour >= 13 && currentHour <= 16) {
            sessionName = "NEW YORK KILLZONE";
            sessionMultiplier = 1.5;
        }

        return {
            valid: true,
            session: sessionName,
            confluenceScore: (parseFloat(rallyData.rr.split(':')[1]) * sessionMultiplier).toFixed(1)
        };
    }
};
