/**
 * Vidya Institutional Engine Module
 * Swept vs Pending Liquidity Tracking & Magnet Target Mapping
 */

const VidyaEngineModule = {
    evaluateLiquiditySweepAndMagnet: function(tfData) {
        if (!tfData) return null;

        let labels = VidyaStrategies.extractLiquidityLabels(tfData);
        let m1 = tfData['1m'];
        if (!labels || !m1 || m1.length === 0) return null;

        let orderflow = VidyaStrategies.calculateOrderflowDelta(m1);
        let currentPrice = orderflow.currentPrice;

        let { pdh, pdl, ash, asl } = labels;

        let sweptLow = currentPrice < asl || currentPrice < pdl;
        let sweptHigh = currentPrice > ash || currentPrice > pdh;

        // Determine Market Direction Bias and Magnet Target
        let direction = "NEUTRAL";
        let targetMagnet = currentPrice;
        let protectedSL = currentPrice;
        let sweptLabelName = "";
        let pendingMagnetName = "";

        if (sweptLow && orderflow.isSpike) {
            // Low Liquidity Swept -> Smart Money Buyer Entry -> Target Top Liquidity
            direction = "BUY";
            sweptLabelName = currentPrice < pdl ? "PDL" : "ASL";
            pendingMagnetName = currentPrice < pdl ? "PDH" : "ASH";
            targetMagnet = currentPrice < pdl ? pdh : ash;
            protectedSL = Math.min(asl, pdl) * 0.9985; // Safe Protected Stop Loss
        } else if (sweptHigh && orderflow.isSpike) {
            // High Liquidity Swept -> Smart Money Seller Entry -> Target Bottom Liquidity
            direction = "SELL";
            sweptLabelName = currentPrice > pdh ? "PDH" : "ASH";
            pendingMagnetName = currentPrice > pdh ? "PDL" : "ASL";
            targetMagnet = currentPrice > pdh ? pdl : asl;
            protectedSL = Math.max(ash, pdh) * 1.0015; // Safe Protected Stop Loss
        }

        let risk = Math.abs(currentPrice - protectedSL);
        let reward = Math.abs(targetMagnet - currentPrice);
        let rrRatio = risk > 0 ? (reward / risk).toFixed(1) : "3.5";

        return {
            direction,
            currentPrice,
            targetMagnet,
            protectedSL,
            rrRatio: `1:${rrRatio}`,
            sweptLabelName,
            pendingMagnetName,
            isAbsorption: orderflow.isAbsorption,
            isSpike: orderflow.isSpike,
            labels
        };
    }
};
