/**
 * Vidya Live Signal Engine
 * Uses the exact same 6-TF SMC + Sweep + Magnet Logic as Backtester.
 */

const VidyaEngineModule = {
    evaluateLiveTradeSignal: function(tfData) {
        if (!tfData) return null;

        let labels = VidyaStrategies.extractSMCLabels(tfData);
        let m1 = tfData['1m'];
        let m15 = tfData['15m'];
        let h1 = tfData['1h'];

        if (!labels || !m1 || !m15 || !h1) return null;

        let orderflow = VidyaStrategies.checkOrderflowAbsorption(m1);
        let currentPrice = orderflow.currentPrice;

        let { pdh, pdl, ash, asl } = labels;

        // HTF Trend Check (1H Direction)
        let h1Current = h1[h1.length - 1].close;
        let h1Prev = h1[Math.max(0, h1.length - 6)].close;
        let isH1Bullish = h1Current >= h1Prev;

        // LTF Sweep Condition
        let last15m = m15[m15.length - 1];
        let isSweepLow = last15m.low < asl || last15m.low < pdl;
        let isSweepHigh = last15m.high > ash || last15m.high > pdh;

        let direction = "NEUTRAL";
        let targetMagnet = currentPrice;
        let protectedSL = currentPrice;
        let sweptLabel = "";
        let pendingMagnet = "";

        // CROSS-CONFLUENCE SIGNAL MATCHING
        if (isSweepLow && orderflow.isSpike && isH1Bullish) {
            direction = "BUY";
            sweptLabel = currentPrice < pdl ? "PDL (Prev Day Low)" : "ASL (Asian Low)";
            pendingMagnet = currentPrice < pdl ? "PDH (Prev Day High)" : "ASH (Asian High)";
            targetMagnet = currentPrice < pdl ? pdh : ash;
            protectedSL = last15m.low * 0.9990; // Protected below sweep wick
        } else if (isSweepHigh && orderflow.isSpike && !isH1Bullish) {
            direction = "SELL";
            sweptLabel = currentPrice > pdh ? "PDH (Prev Day High)" : "ASH (Asian High)";
            pendingMagnet = currentPrice > pdh ? "PDL (Prev Day Low)" : "ASL (Asian Low)";
            targetMagnet = currentPrice > pdh ? pdl : asl;
            protectedSL = last15m.high * 1.0010; // Protected above sweep wick
        }

        if (direction === "NEUTRAL") return null;

        let risk = Math.abs(currentPrice - protectedSL);
        let reward = Math.abs(targetMagnet - currentPrice);
        let rrRatio = risk > 0 ? (reward / risk).toFixed(1) : "3.5";

        return {
            direction,
            currentPrice,
            entry: currentPrice,
            targetMagnet,
            protectedSL,
            rrRatio: `1:${rrRatio}`,
            sweptLabel,
            pendingMagnet,
            isAbsorption: orderflow.isAbsorption
        };
    }
};
