from datetime import datetime
import numpy as np
import pandas as pd
import pytz
import yfinance as yf


def fetch_forex_crypto_data(symbol="EURUSD=X", timeframe="15m", period="60d"):
    """Fetch candle data with Session mapping"""
    df = yf.download(symbol, period=period, interval=timeframe, progress=False)
    if isinstance(df.columns, pd.MultiIndex):
        df.columns = df.columns.get_level_values(0)

    # Convert timezone to UTC for Trading Sessions
    df.index = pd.to_datetime(df.index)
    if df.index.tz is None:
        df.index = df.index.tz_localize("UTC")
    else:
        df.index = df.index.tz_convert("UTC")

    # Tag Trading Sessions (UTC Times)
    # Asian: 00:00 - 08:00 UTC | London: 07:00 - 16:00 UTC | NY: 13:00 - 21:00 UTC
    df["Hour"] = df.index.hour
    df["Session"] = "Off-Hours"
    df.loc[(df["Hour"] >= 0) & (df["Hour"] < 7), "Session"] = "Asian"
    df.loc[(df["Hour"] >= 7) & (df["Hour"] < 13), "Session"] = "London"
    df.loc[(df["Hour"] >= 13) & (df["Hour"] < 21), "Session"] = "New York"

    return df


def detect_smc_levels_and_backtest(df, pip_value=0.0001):
    """Detect Liquidity Sweeps, Order Blocks, Tight SL and Run Backtest"""
    signals = []

    # Calculate Asian High/Low for Liquidity Sweeps in London/NY
    df["Asian_High"] = np.nan
    df["Asian_Low"] = np.nan

    # Identify Swing Highs / Lows (15m/1h)
    lookback = 10
    df["Swing_High"] = df["High"].rolling(window=lookback * 2 + 1).max()
    df["Swing_Low"] = df["Low"].rolling(window=lookback * 2 + 1).min()

    for i in range(50, len(df)):
        curr_time = df.index[i]
        curr_session = df["Session"].iloc[i]

        # Asian High/Low Detection
        today_data = df[df.index.date == curr_time.date()]
        asian_data = today_data[today_data["Session"] == "Asian"]

        if not asian_data.empty:
            asian_high = asian_data["High"].max()
            asian_low = asian_data["Low"].min()
        else:
            asian_high = df["High"].iloc[i - 20 : i].max()
            asian_low = df["Low"].iloc[i - 20 : i].min()

        prev_close = df["Close"].iloc[i - 1]
        curr_low = df["Low"].iloc[i]
        curr_high = df["High"].iloc[i]
        curr_close = df["Close"].iloc[i]

        # 1. Bullish Liquidity Sweep (Asian Low / Swing Low Swept + Instant Rejection)
        if (
            curr_low < asian_low
            and curr_close > asian_low
            and curr_session in ["London", "New York"]
        ):
            entry_price = curr_close
            # Minimal Pip SL (e.g., 3-5 Pips below the Liquidity Sweep wick)
            stop_loss = curr_low - (3 * pip_value)
            # Maximum Target (Opposite Asian High or Swing High)
            target = asian_high + (5 * pip_value)

            risk_pips = abs(entry_price - stop_loss) / pip_value
            reward_pips = abs(target - entry_price) / pip_value
            rr_ratio = (
                round(reward_pips / risk_pips, 2) if risk_pips > 0 else 0
            )

            if rr_ratio >= 2.5:  # High R:R Filter
                signals.append(
                    {
                        "Datetime": curr_time,
                        "Type": "BULLISH_SWEEP_BUY",
                        "Session": curr_session,
                        "Entry": entry_price,
                        "SL": stop_loss,
                        "TP": target,
                        "RR": rr_ratio,
                        "Risk_Pips": round(risk_pips, 1),
                        "Reward_Pips": round(reward_pips, 1),
                        "Reason": f"{curr_session} Killzone me Asian Low Swept hua + Order Block Rejection.",
                        "Index": i,
                        "Asian_High": asian_high,
                        "Asian_Low": asian_low,
                    }
                )

        # 2. Bearish Liquidity Sweep (Asian High / Swing High Swept + Instant Rejection)
        elif (
            curr_high > asian_high
            and curr_close < asian_high
            and curr_session in ["London", "New York"]
        ):
            entry_price = curr_close
            stop_loss = curr_high + (3 * pip_value)
            target = asian_low - (5 * pip_value)

            risk_pips = abs(stop_loss - entry_price) / pip_value
            reward_pips = abs(entry_price - target) / pip_value
            rr_ratio = (
                round(reward_pips / risk_pips, 2) if risk_pips > 0 else 0
            )

            if rr_ratio >= 2.5:
                signals.append(
                    {
                        "Datetime": curr_time,
                        "Type": "BEARISH_SWEEP_SELL",
                        "Session": curr_session,
                        "Entry": entry_price,
                        "SL": stop_loss,
                        "TP": target,
                        "RR": rr_ratio,
                        "Risk_Pips": round(risk_pips, 1),
                        "Reward_Pips": round(reward_pips, 1),
                        "Reason": f"{curr_session} Killzone me Asian High Swept hua + Premium Order Block Rejection.",
                        "Index": i,
                        "Asian_High": asian_high,
                        "Asian_Low": asian_low,
                    }
                )

    signals_df = pd.DataFrame(signals)
    return signals_df
